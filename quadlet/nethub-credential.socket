# The credential channel (design doc §9.1/§9.2): per-execution device
# credentials, in one direction, and nothing else.
#
# This is a PLAIN SYSTEMD UNIT, not a Quadlet one -- Quadlet has no .socket
# generator, so it does not go where nethub.container goes:
#   cp quadlet/nethub-credential.socket ~/.config/systemd/user/
#   cp quadlet/nethub.container quadlet/nethub-sibling.container \
#        ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user enable --now nethub-credential.socket
#   systemctl --user start nethub nethub-sibling
#
# Why a socket unit at all, rather than either container creating the path:
# nothing in either container may call bind(). systemd owns the socket's
# existence, its mode and its ownership, so a misconfigured deployment fails
# visibly here instead of quietly opening a path something else can read.
# nethub/credential_socket.py's serve() accordingly takes an already-listening
# socket and has no code path that could create one.
#
# Flask SERVES this socket and the sibling CONNECTS to it -- never the reverse.
# A deposit endpoint would leave the sibling holding secrets for executions it
# has not started, and could be flooded. That is why Service= below names the
# Flask unit: it is the one that gets handed the listening descriptor.

[Unit]
Description=NetHub credential channel (Flask serves, sibling connects)
Documentation=man:podman-systemd.unit(5)

[Socket]
# %t is the user's runtime dir (/run/user/<uid>). Keep this path SHORT: an
# AF_UNIX path is capped near 108 bytes and the failure is an unhelpful
# OSError at bind time rather than anything mentioning length. The default
# here is ~37 bytes, leaving room; a deployment that relocates it should
# count first. (Encountered for real: a path under a nested scratch
# directory failed with "File name too long".)
ListenStream=%t/nethub/credential.sock

# The mount and the mode are the entire access control (§9.2). There is no
# SO_PEERCRED check and there must not be one: every unit here runs under one
# rootless user, so a uid check tells Flask only "the peer shares my uid",
# which anything a Flask compromise spawns also satisfies.
SocketMode=0600
DirectoryMode=0700

# Creates %t/nethub before anything mounts it, so the directory's mode is
# systemd's decision rather than a side effect of whichever container podman
# happened to start first. Preserved across a socket restart because the
# sibling has it bind-mounted -- removing it out from under a running
# container leaves that container holding a stale mount.
RuntimeDirectory=nethub
RuntimeDirectoryPreserve=yes

# Names the unit that receives the listening descriptor. Required because the
# names differ: systemd only pairs a socket with a service automatically when
# they share a prefix. nethub.container carries the matching Sockets= line.
Service=nethub.service

# --- Verified end-to-end, not written from the manual page ---
# Against a real podman build/run of this image, podman 5.4.1, rootless:
#   * the socket is created 0600 and owned by the invoking user;
#   * gunicorn logs "Listening at: http://0.0.0.0:8080" rather than taking the
#     credential socket as its HTTP listener (that is entrypoint.sh's doing --
#     without it gunicorn logged "Listening at: unix:/.../credential.sock" and
#     nothing answered on the HTTP port at all);
#   * a request on the socket reaches Flask's handler and is answered by the
#     §9.1 interlock;
#   * `systemctl --user restart nethub` re-hands the descriptor over intact.
#
# One start-order rule, learned the same way: systemd refuses to start this
# socket while nethub.service is ALREADY running ("Socket service
# nethub.service already active, refusing"). Start the socket first, or just
# start nethub -- its Requires= pulls this in in the right order. Restarting
# this socket cycles nethub.service with it, so the two never end up holding
# different inodes of the same path; that was checked rather than assumed.

[Install]
WantedBy=sockets.target
