# Reference Quadlet unit for NetHub.
#
# To install by hand, rootless as the user that will run the container. Both
# units are needed -- this one serves the UI, nethub-sibling.container does
# every piece of device work. They share the database and nothing else; device
# credentials travel sealed in the job row (nethub/sealed_credentials.py).
#   cp quadlet/nethub.container quadlet/nethub-sibling.container \
#        ~/.config/containers/systemd/
#   # create the sibling's key pair (prints the public key to set below):
#   mkdir -p ~/.config/nethub
#   podman run --rm --userns=keep-id:uid=1000,gid=1000 \
#        -v ~/.config/nethub:/keys:z --entrypoint python \
#        localhost/nethub:latest -m nethub.sealed_credentials keygen \
#        --out /keys/credential_private_key
#   # fill in SECRET_KEY and ADMIN_PASSWORD (or LoadCredential=) and
#   # NETHUB_CREDENTIAL_PUBLIC_KEY below, and the key lines in the sibling unit
#   systemctl --user daemon-reload
#   systemctl --user start nethub nethub-sibling
#
# Running this unit alone gets you a UI that accepts work and never performs
# any: Flask writes a `queued` row and stops there by design (§9), so with no
# sibling a host-key scan and an upgrade both hang at "Still working" forever.
#
# Host prep -- rootless, so this lives under the invoking user's own XDG
# data dir, no sudo/chown needed:
#   mkdir -p ~/.local/share/nethub/{data,artifacts}

[Unit]
Description=NetHub software lifecycle server
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/nethub:latest
ContainerName=nethub

# Required for the bind mounts below to be writable. The image runs as
# fixed UID 1000 (nethub), but rootless Podman's default user namespace
# does not map that 1:1 to the host: even when the invoking host user is
# also UID 1000, the container sees the bind-mounted directory as a
# different, non-writable owner. keep-id fixes the mapping so container
# UID 1000 *is* the invoking host user for these mounts, regardless of
# that user's real host UID.
UserNS=keep-id:uid=1000,gid=1000

# Gunicorn binds 0.0.0.0:$NETHUB_PORT (8080 by default).
PublishPort=8080:8080

# --- Required ---
# /app/data holds the SQLite database. /app/artifacts is ARTIFACT_STORE --
# NetHub's own flat directory of uploaded image bytes, which the SCP push
# addresses by filename. Unlike the REGISTRIES_ROOT it replaced at build step 7,
# this is not somewhere an admin mounts *their* files for NetHub to point at:
# NetHub owns it, and it is usually a much larger volume than /app/data (a
# single IOS-XE image is ~450 MB and nothing is superseded or pruned yet).
#
# ARTIFACT_STORE must be set explicitly. Its default is <repo root>/instance/
# artifacts, which inside this image is /app/instance/artifacts -- on the
# read-only layer, with no volume behind it -- and artifacts.store_dir() does
# an unguarded os.makedirs(), so leaving it unset makes the artifacts page 500
# on every load.
#
# %h expands to the invoking user's home directory.
# Lowercase :z (shared label), not :Z (private). nethub-sibling.container
# mounts these same two directories, and :Z gives each container its own
# private MCS label: on an SELinux-enforcing host whichever container starts
# second relabels the directory and locks the first out of the database.
# UNVERIFIED on an enforcing host (none was available when this changed);
# harmless where SELinux is disabled.
Volume=%h/.local/share/nethub/data:/app/data:z
Volume=%h/.local/share/nethub/artifacts:/app/artifacts:z
Environment=DATABASE_PATH=/app/data/database.db
Environment=ARTIFACT_STORE=/app/artifacts

# --- Required ---
# Flask/Flask-Login session-signing key. No default, and deliberately NOT
# filled in here: this file is public, so any value committed to it is a
# published signing key. There is no server-side session row in this alpha,
# which makes the cookie signature the only thing authenticating a user --
# a known key is a forged admin session with no password and no login event.
# nethub/config.py refuses an absent key, a placeholder, and anything under
# 32 characters, so the unit will not start until you supply a real one.
#
# Generate once and keep it stable across restarts: rotating it invalidates
# every live session.
#   openssl rand -hex 32
#
# Then either uncomment the line below with your own value...
#Environment=SECRET_KEY=

# ...or, preferably, load it as a systemd credential instead -- see "Systemd
# credential injection" at the bottom of this file. Uncomment the matching
# LoadCredential= line in [Service] and leave the Environment= line above
# commented out. The credential takes priority over the env var either way.

# --- Required ---
# The sibling's public key: device credentials are sealed to it before they
# are stored in the job row, and only the sibling's private key can open them
# (nethub/sealed_credentials.py). Public, so an Environment= line is fine; the
# same value goes in nethub-sibling.container. NetHub refuses to start
# without it. Printed by `python -m nethub.sealed_credentials keygen` (see the
# top of this file), or recovered from the private key with `... public-key
# --key <file>`.
#Environment=NETHUB_CREDENTIAL_PUBLIC_KEY=

# --- Required before any upgrade can be submitted ---
# Comma-separated CIDRs a submitted target address must fall inside. This is
# fail-closed and has no default: while it is unset, every submit is refused.
# That is deliberate -- an unset security setting is not "allow all" -- but it
# does mean a fresh deployment cannot run an upgrade until you set it.
#Environment=DEVICE_TARGET_CIDRS=10.0.0.0/8,192.168.0.0/16

# --- Optional ---
# Port Gunicorn binds to inside the container. Update the left side of
# PublishPort= above to match if you change this.
#Environment=NETHUB_PORT=8080

# --- Optional ---
# Cap request size so an upload can't exhaust disk/memory. Bytes; 1.5 GB by
# default, comfortably above a real IOS-XE image.
#Environment=MAX_CONTENT_LENGTH=1610612736

# --- Optional ---
# Only consulted on first boot, when the database has no users yet -- an
# already-running deployment has its admin(s) and ignores both of these. If
# neither is set, a random password is generated and printed once, to
# `podman logs nethub` / `journalctl --user -u nethub`, on that first boot.

# Username for the first admin account. Everyone who can log in is an admin
# in this alpha -- there are no roles yet to pick between.
#Environment=ADMIN_USERNAME=admin

# Sets the first admin's password directly instead of a random one. Has to
# sit here in plaintext for the container to read it on every restart --
# prefer the admin_password systemd credential below where possible.
#Environment=ADMIN_PASSWORD=

# Local-development escape hatch only -- turns on Werkzeug's interactive
# debugger and reloader. NEVER set this in a deployed Quadlet unit: the
# debugger renders frame locals -- including a submitted password -- into
# an HTTP response on any unhandled exception (see CLAUDE.md's DEBUG hard
# rule). It also has no effect here anyway -- gunicorn (ENTRYPOINT in
# Containerfile) doesn't consult it; it exists for `flask run`/dev.sh.
#Environment=DEBUG=1

# App only ever writes under /app/data, /app/artifacts, /tmp and /run.
ReadOnly=true
Tmpfs=/tmp
Tmpfs=/run

[Service]
Restart=on-failure

# A core dump would write this process's heap -- which holds a submitted
# device password for the length of the request that seals it -- to
# /var/lib/systemd/coredump, where it outlives the credential by however long
# the retention allows. See CLAUDE.md's note that this was a known-open item.
LimitCORE=0

# /proc of other processes is not this container's business.
# ProtectProc=invisible also narrows the same-uid /proc/<pid>/environ and
# /proc/<pid>/mem reads that the separate Flask/sibling PID namespaces exist
# to prevent.
ProtectProc=invisible

# --- Systemd credential injection ---
# LoadCredential=/SetCredential= are plain systemd service directives, not
# Podman/Quadlet keys -- they belong in [Service], not [Container] (Quadlet
# passes this section straight through to the generated .service unit
# unchanged; see `man podman-systemd.unit`, "the [Service] table ... pass
# directly to systemd"). Recent Podman versions forward loaded credentials
# into the container and set $CREDENTIALS_DIRECTORY there automatically;
# confirm this against the Podman version actually in use, and note that
# LoadCredentialEncrypted= specifically has been reported to need
# SecurityLabelDisable=true in [Container] under SELinux enforcing --
# nethub/credentials.py reads $CREDENTIALS_DIRECTORY the same way
# regardless of which of these three directives supplied it.
#
# Uncomment either or both, pointing at a real secret file readable by the
# user this unit runs as (root-only-readable is fine -- systemd, not
# Podman, opens it):
#LoadCredential=secret_key:/path/to/secret-key-file
#LoadCredential=admin_password:/path/to/admin-password-secret
#
# Or generate+encrypt one with systemd-creds and use LoadCredentialEncrypted=
# instead -- see `man systemd-creds`.

[Install]
WantedBy=default.target
