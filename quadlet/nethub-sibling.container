# The dispatch sibling (design doc §7.3, §9; CLAUDE.md "Dispatch").
#
# Install alongside quadlet/nethub.container:
#   cp quadlet/nethub-sibling.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start nethub-sibling
#
# WITHOUT THIS UNIT NOTHING IS EVER DISPATCHED. Flask writes exactly one job
# edge -- the `queued` row -- and every edge after that belongs to this
# process. With no sibling running, a submitted upgrade and a host-key scan
# both sit at `queued` forever, and neither has a staleness story: sweep()
# only reclaims `running` rows, and the scan result page renders `queued` and
# `running` identically as "Still working". The symptom is a screen that never
# advances and a log that says nothing, so check this unit first.
#
# This is a SEPARATE UNIT running the SAME IMAGE, and both halves of that are
# deliberate. Never merge it into nethub.container as a second process, and
# never put the two in a shared Pod=: distinct PID namespaces are what prevent
# same-uid ptrace and /proc/<pid>/mem reads between the process holding the
# only unauthenticated route and the process holding a live device credential.
# One image because nethub/devices/ is ordinary Python in this repo with no
# Flask dependency -- the sibling just starts at a different entrypoint.

[Unit]
Description=NetHub dispatch sibling (phase jobs and host-key scans)
After=network-online.target
Wants=network-online.target

# No dependency on the web unit being up: the two share only the database, and
# a device credential arrives sealed in the job row (nethub/sealed_credentials.py),
# so a web restart between an approval and its phase costs nothing. After an
# upgrade this process waits, logging why, until the web unit has migrated the
# database (nethub/schema.py).

[Container]
Image=localhost/nethub:latest
ContainerName=nethub-sibling

# `python -m nethub.sibling`, replacing the image's gunicorn entrypoint.
Entrypoint=python
Exec=-m nethub.sibling

# Required for the volumes below to be writable -- see nethub.container's own
# note. Rootless Podman's default user namespace does not map the image's
# fixed UID 1000 to the invoking user, even when their host UID is also 1000.
UserNS=keep-id:uid=1000,gid=1000

# The same SQLite file Flask writes, which is why both units must stay on one
# host under one user: SQLite's locking is unreliable on network filesystems,
# so distributing these two means §7 rebuilt around a different database.
# Lowercase :z (shared label), not :Z (private). nethub.container mounts
# these same two directories, and :Z gives each container its own private
# MCS label: on an SELinux-enforcing host whichever container starts
# second relabels the directory and locks the first out of the database.
# UNVERIFIED on an enforcing host (none was available when this changed);
# harmless where SELinux is disabled.
Volume=%h/.local/share/nethub/data:/app/data:z
Volume=%h/.local/share/nethub/artifacts:/app/artifacts:z

Environment=DATABASE_PATH=/app/data/database.db
Environment=ARTIFACT_STORE=/app/artifacts

# Required by the sibling's main(), which exits naming it if unset.
# NETHUB_SEARCH_DIR is the published subtree the SCP push reads the image
# bytes from (§3.3 -- NetHub is the one source), so it is ARTIFACT_STORE, not
# a second copy of anything.
Environment=NETHUB_SEARCH_DIR=/app/artifacts

# --- Required: the key pair (nethub/sealed_credentials.py) ---
# Device credentials reach this process sealed in the job row, to a key pair
# only this unit holds the private half of. Create the pair once with the
# keygen step at the top of nethub.container. The sibling refuses to start
# without a private key, or with one that does not match the public key.
#
# The public key: the same value as in nethub.container.
#Environment=NETHUB_CREDENTIAL_PUBLIC_KEY=
#
# The private key, as a file mounted read-only into this container only.
# Uppercase :Z (private label) on purpose, unlike the shared volumes above:
# no other container should be able to read this file.
#Volume=%h/.config/nethub/credential_private_key:/run/nethub-key/credential_private_key:ro,Z
#Environment=NETHUB_CREDENTIAL_KEY_FILE=/run/nethub-key/credential_private_key
#
# Or as a systemd credential named credential_private_key instead of the two
# lines above: see the LoadCredential= line in [Service] below. The credential
# takes priority when both are present.

# No SECRET_KEY. The sibling signs no cookies and serves no requests, and it
# loads only nethub/shared_config.py, never the web tier's config.py. Don't
# add the key here: it forges an admin session, and this process has no use
# for it.

# DEVICE_TARGET_CIDRS is deliberately absent: it constrains what may be
# *submitted*, which is Flask's side. Setting it here would imply the sibling
# re-checks the address, and it does not -- the run's own rows are what it
# acts on (§3.5).

# Writes nothing outside /app/data and /tmp. No /run tmpfs: /run/nethub-key is
# a real mount and a tmpfs over its parent would shadow it.
ReadOnly=true
Tmpfs=/tmp

[Service]
Restart=on-failure
RestartSec=5

# A core dump would write this process's heap to /var/lib/systemd/coredump --
# and unlike Flask, which holds a device password only for the request that
# seals it, this process holds the live password for the whole of a phase
# execution, which for a stage phase is ~15 minutes per host, and its private
# key for as long as it runs. Confirmed
# to reach the container process itself (/proc/self/limits reads
# "Max core file size 0"), not merely the podman client.
LimitCORE=0

# /proc of other processes is not this container's business -- the same
# narrowing the separate PID namespaces exist to provide.
ProtectProc=invisible

# The private key as a systemd credential, instead of the file mount in
# [Container]. Whether Podman forwards $CREDENTIALS_DIRECTORY into the
# container depends on its version -- confirm it before relying on this (see
# nethub.container's "Systemd credential injection" notes).
#LoadCredential=credential_private_key:%h/.config/nethub/credential_private_key

# NoNewPrivileges= and RestrictSUIDSGID= must NOT be added here. Everything in
# [Service] sandboxes the podman client on the host, not the container, and
# both break rootless Podman's setuid-dependent startup -- RestrictSUIDSGID
# immediately (chown-by-maps on the image's own setuid files),
# NoNewPrivileges latently, at the next reboot, with an error naming neither
# systemd nor this file. nethub.container's comments carry the full reasoning.

[Install]
WantedBy=default.target
