# Local dev only -- never used in production (see Containerfile). Runs the
# Flask dev server (debug + reload) against the repo bind-mounted in at
# `podman run` time, so edits on the host take effect live with no rebuild.
# Same pinned base as Containerfile, so dev and production run the same Python.
# uv runs only in this stage, to turn uv.lock into a hashed requirements file
# that plain pip installs below; it never reaches the dev image. The uv
# image is pinned by digest like the base, and Dependabot bumps both.
FROM ghcr.io/astral-sh/uv:0.13.1@sha256:4a1f3666816dafadd20ceb71eac9a7d56d7ef30279f7d64048519ab901ada336 AS lock
WORKDIR /src
COPY pyproject.toml uv.lock ./
# --frozen exports the lock as committed and never re-resolves; --no-dev
# leaves out pytest and the linters.
RUN ["/uv", "export", "--frozen", "--no-dev", "--no-emit-project", "--output-file", "requirements.txt"]

FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=lock /src/requirements.txt .
RUN pip install --no-cache-dir --require-hashes -r requirements.txt

# No COPY . . here on purpose -- application code comes from the bind mount
# (see dev.sh), so a change on the host is visible to the reloader without
# rebuilding this image. Only dependencies are baked in at build time.

EXPOSE 8080

# CMD's --port is the default and can be overridden with extra `podman run`
# args after the image name; ENTRYPOINT's other flags always apply.
ENTRYPOINT ["flask", "--app", "nethub", "run", "--host", "0.0.0.0", "--debug"]
CMD ["--port", "8080"]
